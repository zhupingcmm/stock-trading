@startuml
title TAP_ON Booking: Full Workflow (Step 0 + Step 1 + Step 2)

' User Submitted Data (User/Operator) & ms-gm-mtm-publication (Existing service, new request implementation)
actor User as upstream #LightGreen
participant "ms-gm-mtm-publication" as mtm #LightBlue

' ms-structured-product-trade-capture & Kafka
participant "ms-structured-product-trade-capture" as tc #LightBlue
participant Kafka as kafka #LightBlue

' ms-structured-product-management (merged: IsinConsumerService + IsinReservationService + ConnectorService + ConnectorConsumerService)
participant "ms-structured-product-management" as pm #LightGray

' Adapters
participant "ms-clearstream-adapter" as cs_adapter #LightBlue
participant "ms-connexor-adapter" as adapter #LightGreen

' External systems
box "External System" #LightYellow
    participant "Clearstream Service" as cs
    participant "Connexor Numbering Service" as connexor
end box

== Step 0: Pre-Trade-Capture Valoren Validation (Booking = TAP_ON) ==
' Trigger: Booking = TAP_ON; new validation rules (Duplicate Check + MTM channel checks)
upstream -[#388E3C]> tc : booking trade data
note right #LightGreen : Validation & Eligibility check

tc -[#388E3C]> tc : Valoren No is provided?

alt Valoren provided (Y)
    ' ---- Branch A: duplicate check ----
    tc -[#388E3C]> tc : Valoren No is duplicated?\n//Duplicate Check against all the trade,\nexcluding deleted trades//
    note right #LightGreen : TC internal method, encapsulates PM data query logic
    pm -[#388E3C]--> tc : duplicated / unique

    alt duplicated (Y)
        tc -[#388E3C]> tc : Push to GMO Exception Queue
        note right #LightGreen : Reason: duplicate Valoren\n(stays inside ms-structured-product-trade-capture)
    else unique (N)
        ' ---- Branch B: query MTM, channel check ----
        tc -[#388E3C]> mtm : POST /v1/internal/distribution-six\nisDistributionSix?(clientId)
        mtm -[#388E3C]--> tc : true (BBG) / false (non BBG)
        note right #LightGreen : Query MTM Module

        alt MTM channel = BBG (Y)
            tc -[#388E3C]> tc : (A) Save to ms-structured-product-trade-capture DB
            note right #LightGreen : Continue to Step 1 (ISIN Activation)
        else MTM channel != BBG (N)
            tc -[#388E3C]> tc : (B) Save to ms-structured-product-trade-capture DB
            note right #LightGreen : Continue to Step 1 (ISIN Activation)
        end
    end
else Valoren NOT provided (N)
    ' ---- Branch C: query MTM for Client + channel check ----
    tc -[#388E3C]> mtm : POST /v1/internal/distribution-six\nisDistributionSix?(clientId)
    mtm -[#388E3C]--> tc : Client found (Y) / not found (N)
    note right #LightGreen : Query MTM Module

    alt Client found (Y)
        tc -[#388E3C]> mtm : MTM channel = SIX?
        mtm -[#388E3C]--> tc : true / false

        alt MTM channel = SIX (Y)
            tc -[#388E3C]> tc : Push to GMO Exception Queue
            note right #LightGreen : Reason: Six-channel client missing Valoren\n(stays inside ms-structured-product-trade-capture)
        else MTM channel != SIX (N)
            tc -[#388E3C]> mtm : MTM channel = BBG?
            mtm -[#388E3C]--> tc : true / false

            alt MTM channel = BBG (Y)
                tc -[#388E3C]> tc : (C) Save to ms-structured-product-trade-capture DB
                note right #LightGreen : Continue to Step 1 (ISIN Activation)
            else MTM channel != BBG (N)
                note right #LightGreen : Not required for Connexor interface
            end
        end
    else Client NOT found (N)
        note right #LightGreen : Not required for Connexor interface
    end
end

== Step 1: ISIN Activation (Existing) ==
tc -[#1976D2]> tc : sendIsinActivationEvent(tradeHeaderDO)
tc -[#1976D2]> kafka : Publish IsinActivationReq
kafka -[#1976D2]>> pm : Consume ISIN_ACTIVATION event
note left #LightBlue : IsinConsumerService (internal)
pm -[#1976D2]> pm : activateIsin(isinActivationReq)
note left #LightBlue : IsinReservationService (internal)
pm -[#1976D2]> cs_adapter : POST /v1/internal/clearstream/activation
cs_adapter -[#1976D2]> cs : call ClearStream activation API
cs -[#1976D2]--> cs_adapter : return isin status
cs_adapter -[#1976D2]--> pm : return isin status
pm -[#1976D2]>> kafka : Publish ISIN_ACTIVE
note left #LightBlue : IsinReservationService (internal)
kafka -[#1976D2]>> tc : Consume ISIN_ACTIVE event
note right #LightBlue : Existing ISIN activation completes

== Step 2: Valoren Activation & BBG Setup (Booking = TAP_ON) ==
tc -[#388E3C]> kafka : Push CONNEXOR_TAP_ON event
kafka -[#388E3C]>> pm : Consume CONNEXOR_TAP_ON event
note left #LightGreen : ConnectorConsumerService (internal)

pm -[#388E3C]> adapter : POST /v1/internal/connexor/tap-on
adapter -[#388E3C]> adapter : constructIBTXml\n(notional amount change)
adapter -[#388E3C]> connexor : EUFS API: upload IBE xml
note right #LightGreen : Scenario: TAP_ON Notional Amount Update\n(IBE XML, e.g. Increase/Decrease event)
connexor -[#388E3C]--> adapter : EUFS response (status)
adapter -[#388E3C]--> pm : return BUSINESS_STATUS
pm -[#388E3C]>> kafka : Publish BUSINESS_STATUS status event
kafka -[#388E3C]>> tc : Consume BUSINESS_STATUS status event

legend right
    |= Color |= Meaning |
    |<#LightBlue> Existing code (Step 1 + existing participants) |
    |<#LightGreen> New code (Step 0 + Step 2 TAP_ON) |
    |<#LightGray> Internal service (ms-structured-product-management) |
    |<#LightYellow> External system |
endlegend

@enduml